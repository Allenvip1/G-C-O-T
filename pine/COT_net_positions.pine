//@version=6
indicator("COT 净持仓 商业/大户/散户 [Jackson]", shorttitle="COT净持仓 [Jackson]", overlay=false, format=format.volume)

import TradingView/LibraryCOT/6 as cot

// ───────── 设置 ─────────
G1 = "数据设置"
product        = input.string("", "CFTC代码（留空=自动识别）", group=G1, tooltip="留空时按当前品种自动映射；映射不到时请手动填入6位CFTC代码，如黄金 088691")
includeOptions = input.bool(true, "包含期权（Futures+Options）", group=G1)
G2 = "显示设置"
showComm  = input.bool(true, "显示 商业套保（Producer/Merchant）", group=G2)
showLarge = input.bool(true, "显示 大户（Managed Money）", group=G2)
showSmall = input.bool(true, "显示 散户（Other Reportables）", group=G2)
colComm   = input.color(#2962FF, "商业套保 颜色", group=G2)
colLarge  = input.color(#26A69A, "大户 颜色", group=G2)
colSmall  = input.color(#EF5350, "散户 颜色", group=G2)

// ───────── 品种自动映射 ─────────
get_code() =>
    switch syminfo.root
        "GC" or "MGC" or "GLD" => "088691"
        "SI" or "SIL" or "SLV" => "084691"
        => na

root = product == "" ? get_code() : product
if na(root)
    runtime.error("当前品种无自动映射，请在设置里手动填入CFTC代码")

// ───────── 读取 Disaggregated 报告持仓 ─────────
req(name, dir) => cot.requestCommitmentOfTraders("Disaggregated", root, includeOptions, name, dir, "All")

commNet  = req("Producer/Merchant/Processor/User", "Long") - req("Producer/Merchant/Processor/User", "Short")
largeNet = req("Managed Money", "Long") - req("Managed Money", "Short")
smallNet = req("Other Reportables", "Long") - req("Other Reportables", "Short")

hline(0, "零轴", color.new(color.gray, 50), hline.style_dashed)
plot(showComm  ? commNet  : na, "商业套保净持仓", colComm,  2)
plot(showLarge ? largeNet : na, "大户净持仓",     colLarge, 2)
plot(showSmall ? smallNet : na, "散户净持仓",     colSmall, 2)
